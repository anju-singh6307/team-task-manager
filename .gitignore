# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
frontend/dist/

# ── Environment variables (never commit real secrets) ─────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ── Prisma ─────────────────────────────────────────────────────────────────────
# keep schema.prisma and migration folders, ignore generated SQL snapshots
prisma/migrations/**/*.sql

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
